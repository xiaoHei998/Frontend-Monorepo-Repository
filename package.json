{
  "name": "frontend-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "dev:alpha": "pnpm --filter web-alpha dev",
    "dev:beta": "pnpm --filter web-beta dev",
    "affected:apps": "node scripts/affected-apps.mjs",
    "compose:up": "pnpm build && docker compose up --build",
    "compose:build": "pnpm build && docker compose build"
  }
}
